{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bilidown",
  "version": "2.3.2",
  "identifier": "com.bilidown.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://127.0.0.1:1420/",
    "beforeBuildCommand": "node scripts/fetch-ffmpeg.mjs && pnpm build:web",
    "beforeDevCommand": "pnpm dev:web"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "bilidown",
        "width": 1024,
        "height": 680,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "visible": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "liquidGlassRegular",
            "underWindowBackground"
          ],
          "state": "active",
          "interactive": false
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
